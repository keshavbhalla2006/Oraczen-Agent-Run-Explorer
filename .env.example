# Every variable this project reads. All are OPTIONAL: the defaults work with no setup.
# No real keys are needed anywhere. The explain endpoint uses a built-in mock provider.

# ---- Backend (Python / FastAPI) ----
# To use a file: copy this to .env, then start the backend from the backend folder with
#   uvicorn app.main:app --port 8000 --env-file ../.env

# Path to the runs dataset. Relative paths are relative to the repo root.
DATA_PATH=data/runs.jsonl
# Explain provider. "mock" is deterministic and needs no API key (the only one implemented).
EXPLAIN_PROVIDER=mock
# Pause between streamed words in the mock provider, in milliseconds.
EXPLAIN_DELAY_MS=30
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend (Next.js) ----
# Put this one in frontend/.env.local (not in the root .env). Where the browser and the
# Next.js server find the Python API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Path to the runs dataset. Optional; defaults to data/runs.jsonl in the repo.
DATA_PATH=data/runs.jsonl

# Explain provider. "mock" is deterministic and needs no API key (default).
EXPLAIN_PROVIDER=mock
# Delay between streamed words in the mock provider, in milliseconds.
EXPLAIN_DELAY_MS=30

# Where the Next.js app finds the Python API. Optional; defaults to http://localhost:8000.
# For local overrides put it in frontend/.env.local (never commit that file).
NEXT_PUBLIC_API_URL=http://localhost:8000